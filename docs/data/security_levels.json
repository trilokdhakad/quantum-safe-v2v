{"source":"Read from FIPS 203/204, the algorithm specifications, RFC 7748 and Roetteler et al. (report/math/05_security_parameters.md)","rows":[{"primitive":"ECDH / ECDSA P-256","used_in":"PSLAP, PSRS-D2D, IEEE 1609.2 today","classical":"≈ 128 bits (Pollard rho 2^127.8)","quantum":"none: Shor, ≈ 2330 logical qubits","source":"Roetteler et al. 2017"},{"primitive":"X25519","used_in":"hybrid mode","classical":"slightly under 128 bits","quantum":"none (Shor)","source":"RFC 7748 §7"},{"primitive":"ML-KEM-768","used_in":"PQ-V2V-AKE key exchange","classical":"NIST category 3; core-SVP 183","quantum":"category 3; core-SVP 166","source":"FIPS 203; Kyber spec v3.02 Table 4"},{"primitive":"ML-KEM-512 (Kyber-512)","used_in":"P²AS-IoAV evaluation","classical":"category 1; core-SVP 118","quantum":"category 1; core-SVP 107","source":"Kyber spec v3.02 Table 4"},{"primitive":"ML-DSA-44","used_in":"PQ-V2V-AKE signatures and certificates","classical":"category 2; core-SVP 123","quantum":"category 2; core-SVP 112","source":"FIPS 204; Dilithium spec v3.1 Table 1"},{"primitive":"Falcon-512","used_in":"safety messages","classical":"category 1; core-SVP 120 (forgery)","quantum":"category 1; core-SVP 108","source":"Falcon spec v1.2 Table 3.3"},{"primitive":"SHA-256","used_in":"transcript hashes","classical":"collisions 2^128, preimages 2^256","quantum":"collisions ≈ 128 bits, preimages 2^128 (Grover)","source":"FIPS 180-4; Brassard–Høyer–Tapp 1998; Bernstein 2009"},{"primitive":"HMAC-SHA-256 / HKDF, 256-bit keys","used_in":"key derivation, MACs","classical":"256 bits","quantum":"128 bits (Grover)","source":"Backendal et al. 2023"},{"primitive":"BB84 + Cascade + Toeplitz","used_in":"QKD path","classical":"information-theoretic, ε ≤ 2·10^-10 + 2^-64","quantum":"same: no computational assumption","source":"Shor–Preskill 2000"}]}