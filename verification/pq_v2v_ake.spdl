/*
 * PQ-V2V-AKE -- Scyther model (symbolic, Dolev-Yao attacker).
 *
 * Mirrors qsv2v/pqc/pq_v2v_ake.py:
 *   m1  I -> R : pkE(ne), NI, cert(I), {pkE(ne), NI, I}sk(I)
 *   m2  R -> I : {ss}pkE(ne), NR, cert(R), {th2}sk(R), MAC(KcR, th3)
 *   m3  I -> R : MAC(KcI, th3, macR)
 *
 * Modelling choices:
 *  - The ephemeral ML-KEM key pair is pkE(ne) / skE(ne) for a fresh nonce ne
 *    that is never sent; pkE/skE are declared inverse keys and skE is a secret
 *    function, so only the role that chose ne can decapsulate. Encapsulation of
 *    the fresh secret ss is modelled as public-key encryption {ss}pkE(ne).
 *  - Pseudonym certificates are the authority's signature binding a pseudonym
 *    to its public key; Scyther's built-in pk(X)/sk(X) with honest agents
 *    models exactly "the key certified for X". Revocation and timestamps are
 *    outside the symbolic model (they are tested in code).
 *  - HKDF and HMAC are modelled as hash functions KDF and MAC over the
 *    session secret and the transcript.
 *
 * Claims: secrecy of ss and of the session key, aliveness, weak agreement,
 * non-injective agreement and synchronisation (Niagree / Nisynch), for both
 * roles -- the same claim set the base papers report.
 * Forward secrecy is tested in code (qsv2v.pqc.attack_suite.forward_secrecy);
 * Scyther's default adversary model does not compromise long-term keys.
 */

hashfunction KDF, MAC, H;
const pkE: Function;
secret skE: Function;
inversekeys (pkE, skE);

protocol PQV2VAKE(I, R)
{
  role I
  {
    fresh ne: Nonce;
    fresh NI: Nonce;
    var NR: Nonce;
    var ss: Nonce;

    send_1(I, R, pkE(ne), NI, {pkE(ne), NI, I}sk(I));
    recv_2(R, I, {ss}pkE(ne), NR,
           {H(pkE(ne), NI, I, {ss}pkE(ne), NR, R)}sk(R),
           MAC(KDF(ss, H(pkE(ne), NI, I, {ss}pkE(ne), NR, R), R), NI, NR));
    send_3(I, R, MAC(KDF(ss, H(pkE(ne), NI, I, {ss}pkE(ne), NR, R), I), NI, NR, R));

    claim_I1(I, Secret, ss);
    claim_I2(I, Secret, KDF(ss, H(pkE(ne), NI, I, {ss}pkE(ne), NR, R)));
    claim_I3(I, Alive);
    claim_I4(I, Weakagree);
    claim_I5(I, Niagree);
    claim_I6(I, Nisynch);
  }

  role R
  {
    var EK: Ticket;
    var NI: Nonce;
    fresh NR: Nonce;
    fresh ss: Nonce;

    recv_1(I, R, EK, NI, {EK, NI, I}sk(I));
    send_2(R, I, {ss}EK, NR,
           {H(EK, NI, I, {ss}EK, NR, R)}sk(R),
           MAC(KDF(ss, H(EK, NI, I, {ss}EK, NR, R), R), NI, NR));
    recv_3(I, R, MAC(KDF(ss, H(EK, NI, I, {ss}EK, NR, R), I), NI, NR, R));

    claim_R1(R, Secret, ss);
    claim_R2(R, Secret, KDF(ss, H(EK, NI, I, {ss}EK, NR, R)));
    claim_R3(R, Alive);
    claim_R4(R, Weakagree);
    claim_R5(R, Niagree);
    claim_R6(R, Nisynch);
  }
}
