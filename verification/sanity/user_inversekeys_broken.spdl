const pkE: Function;
secret skE: Function;
inversekeys (pkE, skE);
protocol T3(I, R) {
  role I { fresh ne: Nonce; var s: Nonce;
    send_1(I, R, pkE(ne), {pkE(ne), R}sk(I)); recv_2(R, I, {s}pkE(ne)); }
  role R { var EK: Ticket; fresh s: Nonce;
    recv_1(I, R, EK, {EK, R}sk(I)); send_2(R, I, {s}EK); claim_r(R, Secret, s); }
}
